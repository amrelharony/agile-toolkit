{
  "extends": ["next/core-web-vitals", "next/typescript"],
  "rules": {
    "no-console": ["error", { "allow": ["warn", "error"] }]
  },
  "overrides": [
    {
      "files": ["scripts/**/*.ts", "scripts/**/*.mjs", "scripts/**/*.js"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["mcp-server/**/*.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["**/__tests__/**/*", "**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
