# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code worktrees
/.claude/worktrees/

# local claude session artifacts (settings.local.json stays tracked)
/.claude/launch.json
/.claude/*.lock
/.claude/round*-findings.md

# mcp-server build artifacts (the source ships; consumers install via npm)
/mcp-server/node_modules
/mcp-server/dist
/mcp-server/*.tsbuildinfo

# auto-generated action registry — regenerated by scripts/generate-action-registry.mjs
# on every pre{dev,build,test}. Committing it would create churn across squad PRs.
/src/lib/actions/_generated/

# supabase CLI scratch dir (link state, edge functions, etc.)
/supabase/.temp/
/supabase/.branches/

# one-off deep-test audit workflow scratch (kept locally, not part of the app)
/audit-pass2.workflow.mjs

# Amr's sprite sheet and his lazy packs are committed under content-hash names
# (amr.<sha256-prefix>.webp, amr-<pack>[@2x].<sha256-prefix>.webp, written by
# scripts/build-mascot-packs.py) so they can be cached immutably. Nothing else from
# the pet pack belongs here: it also holds photo boards and rejected art.
/public/mascot/*
!/public/mascot/amr.*.webp
!/public/mascot/amr-*.webp

# The cast puppets' atlases, built only from approved sources and named after
# their content (aaw-NN[@2x].<sha256-prefix>.webp, by scripts/build-cast-rigs.py).
# The sources, returns and review pages stay in the private sources folder
# (docs/cast/CAST-BUILD.md); nothing else belongs here.
/public/cast/*
!/public/cast/aaw-*.webp

# Lighthouse CI local runs (npm run lighthouse)
/.lighthouseci/
