{
  "name": "agile-toolkit",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0 <23.0.0"
  },
  "scripts": {
    "predev": "node scripts/generate-action-registry.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/generate-action-registry.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "node scripts/generate-action-registry.mjs",
    "test": "vitest",
    "pretest:run": "node scripts/generate-action-registry.mjs",
    "test:run": "vitest run",
    "scaffold:action": "node scripts/scaffold-action.mjs",
    "mcp:smoke": "node scripts/mcp-smoke.mjs",
    "verify:migrations": "node scripts/verify-mcp-migrations.mjs",
    "lighthouse": "npm run build && npx --yes @lhci/cli@0.14.x autorun",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write",
      "eslint --max-warnings=200 --no-error-on-unmatched-pattern"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
