# Agile Toolkit — environment variables
#
# Copy this file to `.env.local` and fill in your Supabase project credentials.
# Without these, the toolkit still works fully in anonymous-only mode:
# auth, cloud history, and realtime gamification all degrade gracefully.

# Supabase project URL — Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key — Project Settings → API → anon public
# Safe to expose; row-level security policies are the real boundary.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
