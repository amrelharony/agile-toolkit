# Agile Toolkit — environment variables
#
# Copy this file to `.env.local` and fill in the values. The toolkit is a
# single-user app: it fails closed (every request 403s) unless AUTHORIZED_EMAILS
# AND the Supabase credentials below are set.

# ──────────────────────────────────────────────────────────────────────
# Single-user auth allowlist
# ──────────────────────────────────────────────────────────────────────
# Comma-separated list of Google account emails allowed to sign in.
# Lowercased + trimmed on read. Missing or empty = deny all (fail closed).
# NOT prefixed NEXT_PUBLIC_ on purpose — never inline this into the bundle.
AUTHORIZED_EMAILS=

# ──────────────────────────────────────────────────────────────────────
# Supabase
# ──────────────────────────────────────────────────────────────────────
# Project URL — Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Anon (public) key — Project Settings → API → anon public
# Safe to expose; RLS policies are the real boundary.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — Project Settings → API → service_role
# SERVER-ONLY. Used by the MCP HTTP transport for PAT lookup (the request
# is unauthenticated at the Postgres layer because the bearer is a PAT,
# not a Supabase JWT; the security-definer function bypasses RLS for the
# hash → user_id resolution). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Legacy JWT secret — Project Settings → JWT Keys → "Legacy JWT Secret"
# (older dashboards: Settings → API → JWT Secret). SERVER-ONLY, and as
# powerful as the service-role key: anyone holding it can sign tokens for any
# role. Used only to mint short-lived Realtime room tokens (role anon) when
# NEXT_PUBLIC_PRIVATE_ROOMS is on. See RUNBOOK.md "Private rooms".
SUPABASE_JWT_SECRET=

# ──────────────────────────────────────────────────────────────────────
# In-app chat agent (owner only) — OpenClaw, or a direct GLM / Z.AI key
# ──────────────────────────────────────────────────────────────────────
# /api/agent/stream uses the FIRST of these that is set (lib/agent/upstream.ts).
# Keys stay on the server; the browser never sees them. With none set, the
# agent falls back to the BYOK GLM key from the AI Settings dialog.
#
# 1. PREFERRED — OpenClaw gateway (the openclaw-sandbox-api behind nginx on the
#    VPS). It holds the Z.AI Coding Plan key itself, so the toolkit needs no
#    GLM key. OPENCLAW_API_KEY is the gateway's own bearer key, sent only to
#    OPENCLAW_URL. Every request also carries the header
#    `X-Caller: agile-toolkit` so nginx can rate-limit the toolkit in its own
#    zone (separate from amrelharony.com's per-IP limit).
OPENCLAW_API_KEY=
# Optional overrides; empty means the default shown. https only (anything
# else falls back to the default). A base URL gets /chat/completions added.
#   OPENCLAW_URL default:   https://chat.amrelharony.com/v1/chat/completions
#   OPENCLAW_MODEL default: openclaw   (the gateway maps openclaw → glm-5.3,
#                                       openclaw-flash → glm-5.3-flash)
OPENCLAW_URL=
OPENCLAW_MODEL=

# 2. FALLBACK — a Zhipu (open.bigmodel.cn) key, used only when
#    OPENCLAW_API_KEY is unset. Sent to https://open.bigmodel.cn/api/paas/v4.
#    A bigmodel key does NOT work on api.z.ai, and a Z.AI key doesn't work here.
#   GLM_AGENT_MODEL default: glm-4.5-flash
#   GLM_BASE_URL default:    https://open.bigmodel.cn/api/paas/v4
GLM_API_KEY=
GLM_AGENT_MODEL=
GLM_BASE_URL=

# 3. LAST — a Z.AI (api.z.ai) key, used only when neither key above is set.
#    Sent to https://api.z.ai/api/paas/v4 (the pay-as-you-go API). For a
#    Coding Plan key set ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4.
#   ZAI_AGENT_MODEL default: glm-5.3-flash
#   ZAI_BASE_URL default:    https://api.z.ai/api/paas/v4
ZAI_API_KEY=
ZAI_AGENT_MODEL=
ZAI_BASE_URL=

# Visitor AI — NOT USED YET (arrives with the visitor chat, PR 2). Visitors
# always go through the OpenClaw gateway above (OPENCLAW_API_KEY), never a
# raw GLM key, and get nothing unless VISITOR_AI_ENABLED is exactly "1".
#   VISITOR_AI_MODEL default: openclaw-flash (glm-5.3-flash on the gateway)
#   VISITOR_AI_HASH_SECRET:   random string for the daily visitor code,
#                             e.g. from `openssl rand -base64 32`
#   NEXT_PUBLIC_VISITOR_AI:   "1" shows the visitor chat in the mascot panel
# Set the two "1" flags last, when going live.
VISITOR_AI_ENABLED=
VISITOR_AI_MODEL=
VISITOR_AI_HASH_SECRET=
NEXT_PUBLIC_VISITOR_AI=

# ──────────────────────────────────────────────────────────────────────
# Mascot sprite sheet (nothing to set)
# ──────────────────────────────────────────────────────────────────────
# Amr's sheet is committed (public/mascot/amr.<hash>.webp, see
# src/components/agent/mascot/mascot-asset.ts). NEXT_PUBLIC_MASCOT_GLB_URL is no
# longer read — remove it from Vercel if it is still set.

# Offline support (public/sw.js) is on in production builds. Set to 1 to turn
# it off: visitors' browsers unregister the worker on their next visit.
NEXT_PUBLIC_DISABLE_SW=

# ──────────────────────────────────────────────────────────────────────
# Visitor live rooms (Planning Poker, Retro, and the anonymous vote rounds
# of Health Check, Psych Safety and Mood Tracker), optional
# ──────────────────────────────────────────────────────────────────────
# Set to 1 to let visitors (no sign-in) run a temporary live room with their
# team over Supabase Realtime broadcast/presence, and anyone (the owner
# included) run an anonymous vote round. No database writes, no new
# secrets. Anything else (or unset) keeps the feature off: no entry points
# render, no visitor channel opens, and vote rounds fall back to entering
# counted totals. Inlined at build time, so a change needs a Vercel
# redeploy. See RUNBOOK.md "Visitor live rooms" and "Live vote rounds" for
# quota monitoring and the emergency brake.
NEXT_PUBLIC_VISITOR_ROOMS=

# Private Realtime rooms. "1" = every room and the owner's sync feeds use
# private channels that Supabase checks against migration 0026's policy, with
# room tokens minted from SUPABASE_JWT_SECRET. Unset = public channels, as
# before. Inlined at build time (redeploy after a change). Follow the order in
# RUNBOOK.md "Private rooms" before turning off "Allow public access".
NEXT_PUBLIC_PRIVATE_ROOMS=
