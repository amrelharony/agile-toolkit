# Agile Toolkit — environment variables
#
# Copy this file to `.env.local` and fill in the values. The toolkit is a
# single-user app: it fails closed (every request 403s) unless AUTHORIZED_EMAILS
# AND the Supabase credentials below are set.

# ──────────────────────────────────────────────────────────────────────
# Single-user auth allowlist
# ──────────────────────────────────────────────────────────────────────
# Comma-separated list of Google account emails allowed to sign in.
# Lowercased + trimmed on read. Missing or empty = deny all (fail closed).
# NOT prefixed NEXT_PUBLIC_ on purpose — never inline this into the bundle.
AUTHORIZED_EMAILS=

# ──────────────────────────────────────────────────────────────────────
# Supabase
# ──────────────────────────────────────────────────────────────────────
# Project URL — Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Anon (public) key — Project Settings → API → anon public
# Safe to expose; RLS policies are the real boundary.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — Project Settings → API → service_role
# SERVER-ONLY. Used by the MCP HTTP transport for PAT lookup (the request
# is unauthenticated at the Postgres layer because the bearer is a PAT,
# not a Supabase JWT; the security-definer function bypasses RLS for the
# hash → user_id resolution). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ──────────────────────────────────────────────────────────────────────
# In-app chat agent (GLM via z.ai, OpenAI-compatible)
# ──────────────────────────────────────────────────────────────────────
# When ZAI_API_KEY is set, the /api/agent/stream route proxies GLM
# server-side so the API key never reaches the browser. When unset, the
# agent falls back to BYOK from the AI Settings dialog (GLM provider).
ZAI_API_KEY=

# Default model the server uses. glm-4.5-flash is on the free tier.
# Upgrade to glm-4.5 or glm-4.6 after topping up at z.ai for stronger
# tool-use chains.
ZAI_AGENT_MODEL=glm-4.5-flash
